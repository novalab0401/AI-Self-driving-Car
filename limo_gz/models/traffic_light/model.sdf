<?xml version="1.0" ?>
<!-- [GZ] Ported from limo_car/models/traffic_light of limo_ros2 (humble_low_Mesh) to Gazebo Harmonic:
     Gazebo/DarkGrey and Gazebo/Black material scripts replaced with plain colors, and the plugin
     replaced with the Harmonic one in src/traffic_light_plugin.cpp. Shapes and sizes are unchanged.

     Use it in a world with:
       <include>
         <uri>model://traffic_light</uri>
         <pose>x y z roll pitch yaw</pose>
       </include>
     The lenses face the model's -y direction. -->
<sdf version="1.9">
  <model name="traffic_light">
    <static>true</static>

    <!-- Pole + housing. Separate from the lens links below so the
         plugin can change each lens's own visual without touching
         these. -->
    <link name="pole">
      <pose>0 0 0 0 0 0</pose>
      <visual name="pole_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.9</length></cylinder></geometry>
        <material>
          <ambient>0.175 0.175 0.175 1</ambient>
          <diffuse>0.175 0.175 0.175 1</diffuse>
        </material>
      </visual>
      <collision name="pole_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.9</length></cylinder></geometry>
      </collision>
      <visual name="head_visual">
        <pose>0 0 1.14 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.48</size></box></geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- One link per lens: the plugin finds a lens by its link name and
         recolors every visual of that link. -->
    <link name="red_light_link">
      <pose>0 -0.065 1.30 0 0 0</pose>
      <visual name="red_visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.15 0 0 1</ambient>
          <diffuse>0.15 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="yellow_light_link">
      <pose>0 -0.065 1.14 0 0 0</pose>
      <visual name="yellow_visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.15 0.1275 0 1</ambient>
          <diffuse>0.15 0.1275 0 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="green_light_link">
      <pose>0 -0.065 0.98 0 0 0</pose>
      <visual name="green_visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0 0.15 0 1</ambient>
          <diffuse>0 0.15 0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Runtime color control: publish std_msgs/String "red"|"yellow"|
         "green"|"off" on /traffic_light/color. See
         src/traffic_light_plugin.cpp. To use two lights in one world,
         give each its own <topic> (and a bridge entry). -->
    <plugin filename="traffic_light_plugin" name="limo_gz::TrafficLight">
      <topic>/traffic_light/color</topic>
      <initial_color>red</initial_color>
    </plugin>
  </model>
</sdf>
