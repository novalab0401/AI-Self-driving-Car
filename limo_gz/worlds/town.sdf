<?xml version="1.0" ?>
<!-- Generated by tools/make_town.py. Edit the script and run it again instead of editing this file.
     Town test map: a walled 11 x 7.5 m space with a two-lane loop road, a cross street, a traffic
     light with stop line and crosswalk, parking slots, zones A/B/C, a building, trees and two
     obstacle boxes. The start point is the origin (0, 0), heading +x. -->
<sdf version="1.9">
  <world name="town">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Needed for the lidar and the camera -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Needed for the IMU -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground with the road painted on it (models/town_ground) -->
    <include>
      <uri>model://town_ground</uri>
      <name>ground</name>
      <pose>2.500 2.625 0 0 0 0</pose>
    </include>

    <model name="wall_south">
      <static>true</static>
      <pose>2.500 -1.175 0.200 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>11.2 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>11.2 0.1 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>2.500 6.425 0.200 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>11.2 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>11.2 0.1 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3.050 2.625 0.200 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.5 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>8.050 2.625 0.200 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.5 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="building">
      <static>true</static>
      <pose>0.550 2.625 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 1.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 0.6</size></box></geometry>
          <material><ambient>0.8 0.7 0.5 1</ambient><diffuse>0.8 0.7 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_red_box">
      <static>true</static>
      <pose>4.300 5.250 0.150 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_blue_box">
      <static>true</static>
      <pose>6.175 3.125 0.150 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tree_1">
      <static>true</static>
      <pose>3.800 3.525 0.250 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.1 0.45 0.15 1</ambient><diffuse>0.1 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tree_2">
      <static>true</static>
      <pose>5.200 2.925 0.250 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.1 0.45 0.15 1</ambient><diffuse>0.1 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Traffic light past the crosswalk, on the right side of the road, facing the oncoming car.
         z as in empty.sdf: most of the pole is below the ground. -->
    <include>
      <uri>model://traffic_light</uri>
      <name>traffic_light</name>
      <pose>1.900 -0.525 -0.739 0 0 -1.5708</pose>
    </include>
  </world>
</sdf>
