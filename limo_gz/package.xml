<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_gz</name>
  <version>0.1.0</version>
  <description>AgileX LIMO (Ackermann) on Gazebo Harmonic for ROS 2 Jazzy. Ported from the limo_car package of limo_ros2.</description>
  <maintainer email="novalab0401@users.noreply.github.com">novalab0401</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- [GZ] for src/traffic_light_plugin.cpp -->
  <depend>gz_plugin_vendor</depend>
  <depend>gz_sim_vendor</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- [GZ] for scripts/dashboard_node.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
